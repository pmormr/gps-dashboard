# OBD-II reader (the van as a sensor): ELM327 serial → MQTT publisher.
# Enabled-gated like sensor-bme680 — stays disabled until the adapter is wired and
# the van session happens, so a host without OBD never crash-loops. The reader is
# engine-gated, so it idles cheaply (connection closed) while parked.
#
# GPS_OBD_PORT pins the adapter device. /dev/ttyUSB0 is the only USB serial device
# today; Phase 5 udev-pins a stable path (like the GPS dongle). The OBD CAN protocol
# auto-detects (the van is ISO 15765-4 CAN 29/500); set GPS_OBD_PROTOCOL=7 to skip
# the scan if reconnect latency ever matters.
[Unit]
Description=OBD-II reader (van ELM327 → MQTT publisher)
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=pmorgan
WorkingDirectory=/mnt/nvme/gps-dashboard
Environment=PYTHONPATH=/mnt/nvme/gps-dashboard
Environment=GPS_DB_PATH=/mnt/nvme/data/gps_history.db
Environment=GPS_SENSOR_NODE=van
Environment=GPS_OBD_PORT=/dev/ttyUSB0
ExecStart=/mnt/nvme/gps-dashboard/.venv/bin/python sensors/obd.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
