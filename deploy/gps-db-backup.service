[Unit]
Description=GPS history DB backup to rex-nas
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pmorgan
WorkingDirectory=/mnt/nvme/gps-dashboard
Environment=GPS_DB_PATH=/mnt/nvme/data/gps_history.db
# Consistent snapshot (SQLite backup API, safe against the live writers) →
# rsync --inplace to the NAS current/ copy → dated NAS-side copy + prune.
# A no-op when rex-nas is unreachable (boondocking) — the tool preflights the
# SSH host and exits 0, keeping the fresh on-NVMe snapshot either way.
ExecStart=/mnt/nvme/gps-dashboard/.venv/bin/python -m tools.backup_db \
    --snap /mnt/nvme/backup/gps_history.snap.db \
    --ssh rex-nas --remote-dir /volume1/backups/gps-dashboard
