# Radio transmission recorder — VOX-gated capture off the Digirig (SP1 A+B mix)
# → WAV files + GPS-snapped radio_transmissions rows. Design: R8 in
# plans/radio-platform-plan.md.
#
# Enabled-gated like sensor-victron/radio-control — stays disabled until the
# Digirig is wired and live-validated, so a host without one never crash-loops.
# On session (re)start the daemon re-pins the C-Media mixer (power-on defaults
# are max gain + AGC ON) and the rig's AF level; a USB replug kills arecord,
# which bounces the session and re-pins by construction.
#
# The gate thresholds and mixer control names are env-tunable here — field
# tweaks are a unit edit + push, not a code change (see radio/recorder.py for
# the full env surface and defaults).
#
# Levels: AF is re-asserted every heartbeat (the rig forgets CI-V-set levels
# across a power cycle). Squelch is operator-owned — the dial always wins
# live; the keeper (radio/levels.py) only restores it after a rig power
# cycle, clamps accidental too-high settings, and raises it a bounded notch
# on the flap-storm / stuck-open-static signatures.
[Unit]
Description=Radio transmission recorder (Digirig VOX capture)
After=sound.target radio-control.service
Wants=radio-control.service

[Service]
Type=simple
User=pmorgan
WorkingDirectory=/mnt/nvme/gps-dashboard
Environment=GPS_DB_PATH=/mnt/nvme/data/gps_history.db
Environment=GPS_RADIO_AUDIO_DIR=/mnt/nvme/data/radio-audio
# Shared dsnoop PCM (deploy/asound.conf) so radio-stream can capture too; the
# codec's hw device is single-open. Requires /etc/asound.conf installed.
Environment=GPS_RADIO_ALSA_DEVICE=digirig_shared
# AF calibration (via the stream): the capture floor is AF-invariant, so AF is
# free SNR until static clips — 0.25 puts open-squelch static peaks at −4.6 dBFS
# (the ceiling). A USB ground isolator now sits inline, dropping the floor to
# ~−64 dBFS (was ~−50) with static/signal unchanged. Recalibrate if the SP1 pad
# lands.
Environment=GPS_RADIO_PIN_AF=0.25
ExecStart=/mnt/nvme/gps-dashboard/.venv/bin/python -m radio.recorder
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
