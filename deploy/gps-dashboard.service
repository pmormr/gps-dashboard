[Unit]
Description=GPS Dashboard Web App
After=network.target

[Service]
Type=simple
User=pmorgan
WorkingDirectory=/mnt/nvme/gps-dashboard
Environment=PYTHONPATH=/mnt/nvme/gps-dashboard
Environment=GPS_DB_PATH=/mnt/nvme/data/gps_history.db
Environment=GPS_TILE_CACHE_DIR=/mnt/nvme/cache/tiles
Environment=GPS_PMTILES_PATH=/mnt/nvme/tiles/northamerica.pmtiles
Environment=GPS_TERRAIN_PMTILES_PATH=/mnt/nvme/tiles/northamerica-terrain.pmtiles
Environment=GPS_NETWORK_DOCS_PATH=/mnt/nvme/paul-network-docs
Environment=GPS_NETWORK_DOCS_GIT_DIR=/mnt/nvme/paul-network-docs.git
# The /api/cameras/<node>/snapshot proxy authenticates to the cameras with the
# shared Dahua password (digest); leading `-` keeps it optional (the endpoint
# just 502s without it). Same root-600 secret the dahua_reader + mediamtx use.
EnvironmentFile=-/etc/default/gps-dahua
ExecStart=/mnt/nvme/gps-dashboard/.venv/bin/python api/app.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
