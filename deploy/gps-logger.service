[Unit]
Description=GPS Data Logger
After=network.target gpsd.service
Wants=gpsd.service

[Service]
Type=simple
User=pmorgan
WorkingDirectory=/mnt/nvme/gps-dashboard
Environment=PYTHONPATH=/mnt/nvme/gps-dashboard
Environment=GPS_DB_PATH=/mnt/nvme/data/gps_history.db
ExecStart=/mnt/nvme/gps-dashboard/.venv/bin/python logger/gps_logger.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
