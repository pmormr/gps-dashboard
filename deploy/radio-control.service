# rigctld owning the Icom ID-5100A CI-V serial port (model 3071), exposing Hamlib's
# TCP text protocol on 127.0.0.1:4532 for the Flask radio routes. The daemon-owns-the
# -port model also solves serial contention (R2/R3 in .claude/modules/radio.md).
#
# Enabled-gated like sensor-obd/sensor-victron: stays DISABLED until the CI-V cable is
# wired, so a host without the radio never crash-loops. To bring up:
#   sudo cp deploy/99-icom-civ.rules /etc/udev/rules.d/ && sudo udevadm control --reload
#   (plug the cable into the radio's [SP2] jack)
#   sudo systemctl enable --now radio-control
#
# Live-validated against the rig 2026-07-02: 19200 baud confirmed; no civaddr flag
# needed (the model-3071 backend defaults to the rig's 0x8C). rigctld defers the
# serial open until a client connects, so the unit runs cleanly before plug-in.
[Unit]
Description=rigctld (Icom ID-5100A CI-V control)
After=network.target

[Service]
Type=simple
User=pmorgan
ExecStart=/usr/bin/rigctld -m 3071 -r /dev/icom-civ -s 19200 -T 127.0.0.1 -t 4532
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
