# MediaMTX media hub (R10 in .claude/modules/radio.md) — RTSP + WebRTC
# fan-out for the radio audio stream and the van's Dahua cams, pulled
# on-demand (plans/cameras-plan.md).
#
# The binary is a manual install (static arm64 build at /mnt/nvme/mediamtx/;
# the deploy hook copies only *.service/*.timer). The config lives in the
# deploy checkout so edits deploy on push. Enabled-gated like radio-recorder —
# stays disabled until the stream plane is wired and validated.
[Unit]
Description=MediaMTX media hub (RTSP/WebRTC)
After=network.target

[Service]
Type=simple
User=pmorgan
# The Dahua RTSP sources carry the camera password, which must stay out of git.
# mediamtx.yml ships as a template (MediaMTX itself does not interpolate ${VAR});
# mediamtx-run.sh reads GPS_DAHUA_PASSWORD from this EnvironmentFile at startup,
# URL-encodes it, substitutes the placeholder, and writes the rendered config
# into the tmpfs RuntimeDirectory (0600). Leading `-`: the secret is optional —
# the radio-only paths need none and the service starts dormant without it.
RuntimeDirectory=mediamtx
RuntimeDirectoryMode=0700
EnvironmentFile=-/etc/default/gps-dahua
ExecStart=/bin/bash /mnt/nvme/gps-dashboard/deploy/mediamtx-run.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
