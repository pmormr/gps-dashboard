# picam1 -> MediaMTX path cam1 (hill-climb hc-cam-1). One 720p cam per Pi.
# Device pinned by USB port (by-path) so it survives video-node renumbering:
# picam1's port-1.1 camera. The port-1.2 camera is currently unused -- the USB2
# bus can't carry two 720p YUYV streams (see picam1.md).
CAM_DEVICE=/dev/v4l/by-path/platform-fd500000.pcie-pci-0000:01:00.0-usb-0:1.1:1.0-video-index0
CAM_PATH=cam1
HUB_HOST=192.168.42.178
HUB_PORT=8890
CAM_W=1280
CAM_H=720
CAM_FPS=10
CAM_BITRATE=2500k
