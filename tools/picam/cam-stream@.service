[Unit]
Description=Hill-climb camera encoder (%i) -> MediaMTX SRT
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=pmorgan
SupplementaryGroups=video
EnvironmentFile=/etc/default/cam-stream-%i
ExecStart=/usr/local/bin/cam-stream.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
